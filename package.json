{
  "name": "meally",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "lint": "oxlint --ignore-pattern dist-edge",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build -w apps/web && npm run build -w apps/server",
    "e2e": "playwright test -c e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.7",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
