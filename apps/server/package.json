    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "node-html-parser": "^9.0.7",
    "postgres": "3.4.9",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^24.19.2",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
