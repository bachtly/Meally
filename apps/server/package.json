{
  "name": "@meally/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "build:edge": "node scripts/build-edge.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
